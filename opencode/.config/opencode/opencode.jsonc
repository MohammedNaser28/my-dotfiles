{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-2.0-flash-001",
  "small_model": "openrouter/google/gemini-2.0-flash-001",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "YOUR_OPENROUTER_API_KEY",
        "websearch_cited": {
          "model": "openrouter/google/gemini-2.0-flash-001"
        }
      }
    },
    "crofai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CrofAI",
      "options": {
        "baseURL": "https://crof.ai/v1",
        "apiKey": "nahcrof_YOUR_API_KEY_HERE"
      }
    }
  },
  "plugin": ["@tretrauit/opencode-crofai","opencode-websearch-cited@1.1.1","octto"]
}
