{
  "categories": [
    {
      "name": "System & Shortcuts",
      "entries": [
        {
          "bind": "MOD + Shift + Escape",
          "action": "Hotkey Overlay",
          "desc": "Built-in niri keybind overlay",
          "exec": "niri msg action show-hotkey-overlay"
        }
      ]
    },
    {
      "name": "Applications",
      "entries": [
        {
          "bind": "MOD + Return",
          "action": "Terminal",
          "desc": "Open Alacritty terminal",
          "exec": "alacritty"
        },
        {
          "bind": "MOD + Alt + Return",
          "action": "Terminal",
          "desc": "Open Kitty terminal",
          "exec": "kitty"
        },
        {
          "bind": "MOD + B",
          "action": "Browser",
          "desc": "Open Firefox Developer Edition",
          "exec": "firefox-developer-edition"
        },
        {
          "bind": "MOD + Alt + B",
          "action": "Browser",
          "desc": "Open Google Chrome",
          "exec": "google-chrome-stable --enable-features=TouchpadOverscrollHistoryNavigation"
        },
        {
          "bind": "MOD + A",
          "action": "App Launcher",
          "desc": "Toggle Vicinae launcher",
          "exec": "vicinae toggle"
        },
        {
          "bind": "MOD + E",
          "action": "File Manager",
          "desc": "Open Thunar GUI",
          "exec": "thunar"
        },
        {
          "bind": "MOD + Alt + E",
          "action": "File Manager",
          "desc": "Open Yazi TUI",
          "exec": "yazi"
        },
        {
          "bind": "MOD + W",
          "action": "Wallpaper",
          "desc": "Open wallpaper selector",
          "exec": "$HOME/.config/scripts/bgselector.sh"
        },
        {
          "bind": "MOD + Shift + Q",
          "action": "Lock Screen",
          "desc": "Lock with GTKLock",
          "exec": "gtklock"
        },
        {
          "bind": "MOD + D",
          "action": "Display Manager",
          "desc": "Niri display/output configurator (TUI)",
          "exec": "niri-display-manager"
        },
        {
          "bind": "MOD + Shift + V",
          "action": "Clipboard History",
          "desc": "Show cliphist history via vicinae",
          "exec": "cliphist list | vicinae dmenu | cliphist decode | wl-copy"
        }
      ]
    },
    {
      "name": "Media Controls",
      "entries": [
        {
          "bind": "XF86AudioRaiseVolume",
          "action": "Volume Up",
          "desc": "Increase audio volume",
          "exec": "mediactl volume_up"
        },
        {
          "bind": "XF86AudioLowerVolume",
          "action": "Volume Down",
          "desc": "Decrease audio volume",
          "exec": "mediactl volume_down"
        },
        {
          "bind": "XF86AudioMute",
          "action": "Mute",
          "desc": "Toggle audio mute",
          "exec": "mediactl volume_mute"
        },
        {
          "bind": "XF86AudioMicMute",
          "action": "Mic Mute",
          "desc": "Toggle microphone mute",
          "exec": "mediactl mic_mute"
        },
        {
          "bind": "XF86MonBrightnessUp",
          "action": "Brightness Up",
          "desc": "Increase screen brightness",
          "exec": "mediactl brightness_up"
        },
        {
          "bind": "XF86MonBrightnessDown",
          "action": "Brightness Down",
          "desc": "Decrease screen brightness",
          "exec": "mediactl brightness_down"
        },
        {
          "bind": "XF86AudioPlay",
          "action": "Play/Pause",
          "desc": "Toggle media playback",
          "exec": "mediactl play_pause"
        },
        {
          "bind": "XF86AudioPause",
          "action": "Pause",
          "desc": "Pause media",
          "exec": "mediactl play_pause"
        },
        {
          "bind": "XF86AudioNext",
          "action": "Next Track",
          "desc": "Skip to next track",
          "exec": "mediactl next_track"
        },
        {
          "bind": "XF86AudioPrev",
          "action": "Previous Track",
          "desc": "Go to previous track",
          "exec": "mediactl prev_track"
        }
      ]
    },
    {
      "name": "Window Management",
      "entries": [
        {
          "bind": "MOD + Q",
          "action": "Close Window",
          "desc": "Close the focused window",
          "exec": "niri msg action close-window"
        },
        {
          "bind": "MOD + H / Left",
          "action": "Focus Left",
          "desc": "Focus column or window left",
          "exec": "niri msg action focus-column-left"
        },
        {
          "bind": "MOD + J / Down",
          "action": "Focus Down",
          "desc": "Focus workspace down / window down",
          "exec": "niri msg action focus-workspace-down"
        },
        {
          "bind": "MOD + K / Up",
          "action": "Focus Up",
          "desc": "Focus workspace up / window up",
          "exec": "niri msg action focus-workspace-up"
        },
        {
          "bind": "MOD + L / Right",
          "action": "Focus Right",
          "desc": "Focus column or window right",
          "exec": "niri msg action focus-column-right"
        },
        {
          "bind": "MOD + Home",
          "action": "Focus First",
          "desc": "Focus first column",
          "exec": "niri msg action focus-column-first"
        },
        {
          "bind": "MOD + End",
          "action": "Focus Last",
          "desc": "Focus last column",
          "exec": "niri msg action focus-column-last"
        },
        {
          "bind": "MOD + Shift + H / Left",
          "action": "Move Left",
          "desc": "Move column left",
          "exec": "niri msg action move-column-left"
        },
        {
          "bind": "MOD + Shift + J",
          "action": "Move to Workspace Down",
          "desc": "Move column to workspace below",
          "exec": "niri msg action move-column-to-workspace-down"
        },
        {
          "bind": "MOD + Shift + K",
          "action": "Move to Workspace Up",
          "desc": "Move column to workspace above",
          "exec": "niri msg action move-column-to-workspace-up"
        },
        {
          "bind": "MOD + Shift + L / Right",
          "action": "Move Right",
          "desc": "Move column right",
          "exec": "niri msg action move-column-right"
        },
        {
          "bind": "MOD + Shift + Down",
          "action": "Move Window Down",
          "desc": "Move window down within column",
          "exec": "niri msg action move-window-down"
        },
        {
          "bind": "MOD + Shift + Up",
          "action": "Move Window Up",
          "desc": "Move window up within column",
          "exec": "niri msg action move-window-up"
        },
        {
          "bind": "MOD + Shift + Home",
          "action": "Move to First",
          "desc": "Move column to first position",
          "exec": "niri msg action move-column-to-first"
        },
        {
          "bind": "MOD + Shift + End",
          "action": "Move to Last",
          "desc": "Move column to last position",
          "exec": "niri msg action move-column-to-last"
        }
      ]
    },
    {
      "name": "Workspace Management",
      "entries": [
        {
          "bind": "MOD + 1-9",
          "action": "Switch Workspace",
          "desc": "Switch to workspace 1-9",
          "exec": null
        },
        {
          "bind": "MOD + Shift + 1-9",
          "action": "Move to Workspace",
          "desc": "Move window to workspace 1-9",
          "exec": null
        },
        {
          "bind": "MOD + Tab",
          "action": "Previous Workspace",
          "desc": "Switch to previous workspace",
          "exec": "niri msg action focus-workspace-previous"
        },
        {
          "bind": "MOD + Escape",
          "action": "Overview",
          "desc": "Toggle workspace overview",
          "exec": "niri msg action toggle-overview"
        },
        {
          "bind": "MOD + Scroll Up/Down",
          "action": "Workspace Navigation",
          "desc": "Focus previous/next workspace",
          "exec": null
        },
        {
          "bind": "MOD + Shift + Scroll Up/Down",
          "action": "Move to Workspace",
          "desc": "Move column to workspace",
          "exec": null
        }
      ]
    },
    {
      "name": "Monitor Management",
      "entries": [
        {
          "bind": "MOD + Ctrl + H / Left",
          "action": "Focus Monitor Left",
          "desc": "Focus monitor to the left",
          "exec": "niri msg action focus-monitor-left"
        },
        {
          "bind": "MOD + Ctrl + L / Right",
          "action": "Focus Monitor Right",
          "desc": "Focus monitor to the right",
          "exec": "niri msg action focus-monitor-right"
        },
        {
          "bind": "MOD + Ctrl + K / Up",
          "action": "Focus Monitor Up",
          "desc": "Focus monitor above",
          "exec": "niri msg action focus-monitor-up"
        },
        {
          "bind": "MOD + Ctrl + J / Down",
          "action": "Focus Monitor Down",
          "desc": "Focus monitor below",
          "exec": "niri msg action focus-monitor-down"
        },
        {
          "bind": "MOD + Shift + Ctrl + H / Left",
          "action": "Move to Monitor Left",
          "desc": "Move column to left monitor",
          "exec": "niri msg action move-column-to-monitor-left"
        },
        {
          "bind": "MOD + Shift + Ctrl + L / Right",
          "action": "Move to Monitor Right",
          "desc": "Move column to right monitor",
          "exec": "niri msg action move-column-to-monitor-right"
        },
        {
          "bind": "MOD + Shift + Ctrl + K / Up",
          "action": "Move to Monitor Up",
          "desc": "Move column to upper monitor",
          "exec": "niri msg action move-column-to-monitor-up"
        },
        {
          "bind": "MOD + Shift + Ctrl + J / Down",
          "action": "Move to Monitor Down",
          "desc": "Move column to lower monitor",
          "exec": "niri msg action move-column-to-monitor-down"
        }
      ]
    },
    {
      "name": "Layout Controls",
      "entries": [
        {
          "bind": "MOD + C",
          "action": "Center Column",
          "desc": "Center the focused column",
          "exec": "niri msg action center-column"
        },
        {
          "bind": "MOD + Ctrl + C",
          "action": "Center All",
          "desc": "Center all visible columns",
          "exec": "niri msg action center-visible-columns"
        },
        {
          "bind": "MOD + [",
          "action": "Narrower",
          "desc": "Decrease column width by 10%",
          "exec": "niri msg action set-column-width -10%"
        },
        {
          "bind": "MOD + ]",
          "action": "Wider",
          "desc": "Increase column width by 10%",
          "exec": "niri msg action set-column-width +10%"
        },
        {
          "bind": "MOD + Shift + [",
          "action": "Shorter",
          "desc": "Decrease window height by 10%",
          "exec": "niri msg action set-window-height -10%"
        },
        {
          "bind": "MOD + Shift + ]",
          "action": "Taller",
          "desc": "Increase window height by 10%",
          "exec": "niri msg action set-window-height +10%"
        },
        {
          "bind": "MOD + Ctrl + Scroll Down",
          "action": "Shrink Height",
          "desc": "Decrease window height by 5%",
          "exec": "niri msg action set-window-height -5%"
        },
        {
          "bind": "MOD + Ctrl + Scroll Up",
          "action": "Grow Height",
          "desc": "Increase window height by 5%",
          "exec": "niri msg action set-window-height +5%"
        }
      ]
    },
    {
      "name": "Window Modes",
      "entries": [
        {
          "bind": "MOD + T",
          "action": "Toggle Floating",
          "desc": "Float/unfloat the focused window",
          "exec": "niri msg action toggle-window-floating"
        },
        {
          "bind": "MOD + F",
          "action": "Fullscreen",
          "desc": "Toggle fullscreen",
          "exec": "niri msg action fullscreen-window"
        },
        {
          "bind": "MOD + M",
          "action": "Maximize",
          "desc": "Maximize column width",
          "exec": "niri msg action maximize-column"
        }
      ]
    },
    {
      "name": "Utilities",
      "entries": [
        {
          "bind": "MOD + S",
          "action": "Screenshot",
          "desc": "Interactive screenshot (select area)",
          "exec": "niri msg action screenshot"
        },
        {
          "bind": "MOD + Shift + S",
          "action": "Screenshot Screen",
          "desc": "Capture entire screen",
          "exec": "niri msg action screenshot-screen"
        },
        {
          "bind": "MOD + Ctrl + S",
          "action": "Screenshot Window",
          "desc": "Capture focused window",
          "exec": "niri msg action screenshot-window"
        },
        {
          "bind": "MOD + P",
          "action": "Color Picker",
          "desc": "Pick a color from screen",
          "exec": "hyprpicker"
        },
        {
          "bind": "MOD + Alt + W",
          "action": "Restart Waybar",
          "desc": "Reload the status bar",
          "exec": "pkill waybar; waybar &"
        },
        {
          "bind": "MOD + /",
          "action": "Keybind Viewer",
          "desc": "Show this keybind reference",
          "exec": "keybinds-view"
        },
        {
          "bind": "MOD + Shift + /",
          "action": "Keybind Manager",
          "desc": "Add/edit/remove keybinds and check conflicts",
          "exec": "keybinds-manager"
        }
      ]
    }
  ]
}
